;; The open-kyber appview Worker. :esm, mirroring cloud-itonami-marketplace-listing
;; and cloud-itonami/app-ongakuka.
;;
;; wrangler.jsonc's main points at ../dist/worker.js, which is THIS bundle compiled
;; from the source in src/. That is the whole point of the migration recorded in
;; docs/adr/0001: before it, main pointed at a SvelteKit build output that is not in
;; the tree AND cannot be produced from it (svelte/package.json's dependencies are
;; `workspace:*` and there is no workspace here -- measured, npm EUNSUPPORTEDPROTOCOL).
;;
;; :warnings-as-errors is not decoration. shadow treats an undeclared or renamed
;; var as a WARNING, so `amu compile --target wasm32-browser worker` exits 0 while writing a
;; bundle that misbehaves on the first request. "The build succeeded" is therefore
;; not a check at all -- it cannot fail. Demonstrated in THIS repo before landing
;; this line (docs/operator-quickstart.md S4).
{:deps {:aliases [:cljs]}
 :builds
 {:worker
  {:target :esm
   :output-dir "dist"
   :modules {:worker {:exports {default openkyber.worker/handler}}}
   ;; NOTE the key lives under :compiler-options, NOT :build-options -- shadow
   ;; reads `[:compiler-options :warnings-as-errors]`
   ;; (shadow/build/compiler.clj `should-warning-throw?`). Putting it under
   ;; :build-options is silently ignored, which is the same failure this option
   ;; exists to prevent: a fix that cannot fail.
   :compiler-options {:output-feature-set :es2020
                      :infer-externs :auto
                      :warnings-as-errors true}}}}
